---
import { event } from '../../data/event'

interface Props {
  ctaHref?: string
  ctaLabel?: string
  note?: string
}
const {
  ctaHref = '#inscricao',
  ctaLabel = 'Quero garantir minha vaga',
  note = 'vagas limitadas',
} = Astro.props
---
<section class="hero">
  <div class="hero-bg" style="background-image: url('/hero-bg.jpg')"></div>
  <div class="hero-overlay"></div>
  <div class="hero-inner">
    <span class="hero-eyebrow">Network Entre Elas · {event.dateLabel}</span>
    <h1 class="hero-title">{event.tagline}</h1>
    <a class="hero-cta" href={ctaHref} target={ctaHref.startsWith('http') ? '_blank' : undefined} rel={ctaHref.startsWith('http') ? 'noopener' : undefined}>
      {ctaLabel} <span aria-hidden="true">→</span>
    </a>
    {note && <p class="hero-note">{note}</p>}
  </div>
</section>

<style>
.hero {
  position: relative;
  min-height: var(--vh-full);
  display: flex;
  align-items: center;
  padding: var(--space-16) var(--space-6);
  overflow: hidden;
}
.hero-bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center 25%;
  z-index: 0;
}
.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(1,38,89,0.55) 0%, rgba(1,38,89,0.72) 55%, rgba(1,38,89,0.92) 100%);
  z-index: 0;
}
.hero-inner {
  max-width: var(--container-reading);
  margin: 0 auto;
  text-align: center;
  position: relative;
  z-index: 1;
}
.hero-eyebrow {
  display: inline-block;
  font-family: var(--font-ui);
  font-size: var(--type-micro);
  font-weight: 700;
  letter-spacing: var(--letter-uppercase);
  text-transform: uppercase;
  color: #fff;
  background: rgba(255,255,255,0.14);
  border: 1px solid rgba(255,255,255,0.28);
  backdrop-filter: blur(6px);
  padding: 7px 18px;
  border-radius: 999px;
  margin-bottom: var(--space-7);
}
.hero-title {
  font-size: clamp(2.4rem, 7vw, 4.4rem);
  font-weight: 300;
  line-height: 1.08;
  color: #fff;
  margin-bottom: var(--space-9);
  text-shadow: 0 4px 24px rgba(0,0,0,0.35);
}
.hero-cta {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: #fff;
  color: var(--rec-blue);
  font-family: var(--font-ui);
  font-weight: 700;
  font-size: 1rem;
  letter-spacing: 0.02em;
  padding: 19px 40px;
  border-radius: 999px;
  text-decoration: none;
  box-shadow: 0 16px 40px rgba(0,0,0,0.32);
  transition: transform var(--motion-fast) var(--easing), box-shadow var(--motion-fast) var(--easing);
}
.hero-cta:hover { transform: translateY(-2px); box-shadow: 0 20px 48px rgba(0,0,0,0.4); }
.hero-note {
  margin-top: var(--space-5);
  font-size: var(--type-micro);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.8);
}

@media (max-width: 640px) {
  .hero { padding: var(--space-10) var(--space-4); }
  .hero-bg { background-position: center 18%; }
  .hero-title { margin-bottom: var(--space-7); }
}
</style>
