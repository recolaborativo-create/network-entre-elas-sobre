---
const year = new Date().getFullYear()
---
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand-col">
        <img src="/logo-white.png" alt="REC Colaborativo" class="footer-logo" />
        <p class="footer-tagline">movimento <em>gera</em> movimento.</p>
        <p class="footer-locale">Network Entre Elas</p>
      </div>

      <div class="footer-col footer-contact-block">
        <h3>contato</h3>
        <ul>
          <li>
            <a href="https://wa.me/5551984632545" target="_blank" rel="noopener">
              <span class="contact-label">whatsapp</span>
              <span class="contact-value">51 98463-2545</span>
            </a>
          </li>
          <li>
            <a href="https://instagram.com/somosrecoficial" target="_blank" rel="noopener">
              <span class="contact-label">instagram</span>
              <span class="contact-value">@somosrecoficial</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="footer-copy">© {year} REC Colaborativo, todos os direitos reservados</span>
      <a href="https://somosrecoficial.com.br" class="footer-link">somosrecoficial.com.br</a>
    </div>
  </div>
</footer>

<style>
/* Gradiente copiado literalmente do footer do site institucional (ManifestoFooter.astro) */
.footer {
  /* Funde com o branco do FAQ antes do azul escuro sólido. */
  background:
    linear-gradient(180deg, var(--surface) 0%, #042050 100%) top / 100% 32px no-repeat,
    linear-gradient(180deg, #042050 0%, #021438 60%, #010b22 100%);
  color: rgba(255,255,255,0.85);
  padding: var(--space-12) var(--space-6) var(--space-6);
  font-size: var(--type-small);
}
.footer-inner { max-width: var(--container-max); margin: 0 auto; }
.footer-top { display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--space-8); padding-bottom: var(--space-8); border-bottom: 1px solid rgba(255,255,255,0.08); }
.footer-brand-col { display: flex; flex-direction: column; gap: var(--space-3); }
.footer-logo { width: 110px; height: auto; }
.footer-tagline { font-size: 1rem; color: rgba(255,255,255,0.85); font-weight: 300; line-height: 1.4; margin: 0; }
.footer-tagline em { color: var(--rec-teal); font-style: italic; font-weight: 700; }
.footer-locale { font-size: var(--type-micro); color: rgba(255,255,255,0.5); letter-spacing: 0.1em; text-transform: uppercase; margin: 0; }
.footer-col h3 { font-size: var(--type-micro); letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.55); font-weight: 700; margin-bottom: var(--space-4); }
.footer-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-3); }
.footer-col a { color: rgba(255,255,255,0.85); transition: color var(--motion-fast) var(--easing); display: inline-flex; flex-direction: column; gap: 2px; text-decoration: none; }
.footer-col a:hover { color: var(--rec-teal); }
.contact-label { font-size: var(--type-micro); color: rgba(255,255,255,0.5); letter-spacing: 0.1em; text-transform: uppercase; }
.contact-value { font-weight: 600; font-size: var(--type-small); }
.footer-bottom { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-3); padding-top: var(--space-6); }
.footer-copy { font-size: var(--type-micro); color: rgba(255,255,255,0.4); letter-spacing: 0.05em; }
.footer-link { font-size: var(--type-micro); color: rgba(255,255,255,0.6); text-decoration: underline; text-underline-offset: 3px; }

@media (max-width: 560px) {
  .footer-top { grid-template-columns: 1fr; gap: var(--space-6); }
  .footer-bottom { flex-direction: column; align-items: flex-start; gap: var(--space-2); }
  .footer { padding: var(--space-10) var(--space-4) var(--space-5); }
}
</style>
